# Copy to .env (git-ignored) and fill in. Leave a value empty to turn that
# feature off: the app then uses the bundled word and sends no ping.
EXPO_PUBLIC_WORD_ENDPOINT=https://words-and-waffles.example.workers.dev/v1/word
EXPO_PUBLIC_PING_ENDPOINT=https://words-and-waffles.example.workers.dev/v1/ping
